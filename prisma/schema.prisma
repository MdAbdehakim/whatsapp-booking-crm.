// Prisma Schema for Production (PostgreSQL / Supabase / Neon)
// For local SQLite dev, use: npx prisma db push --schema=prisma/schema.sqlite.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Clinic {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique // e.g., "dr-amine-bennani"
  doctorName     String
  specialty      String         // e.g., "Chirurgien-Dentiste", "Ophtalmologue"
  phone          String         // WhatsApp contact for the clinic
  email          String?
  address        String
  city           String         @default("Casablanca")
  googleMapsUrl  String?
  welcomeMessage String?
  logoUrl        String?
  
  users          User[]
  services       Service[]
  availabilities Availability[]
  appointments   Appointment[]
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("SECRETARY") // "ADMIN_DOCTOR" | "SECRETARY"
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Service {
  id          String        @id @default(cuid())
  name        String        // e.g. "Consultation & Bilan Dentaire", "Détartrage"
  description String?
  durationMin Int           @default(30)
  price       Float?        // In MAD (Dirhams)
  color       String        @default("#128C7E")
  clinicId    String
  clinic      Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  createdAt   DateTime      @default(now())
}

model Availability {
  id        String   @id @default(cuid())
  dayOfWeek Int      // 0 = Sunday, 1 = Monday, 2 = Tuesday...
  startTime String   // "09:00"
  endTime   String   // "18:00"
  isActive  Boolean  @default(true)
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, dayOfWeek])
}

model Patient {
  id           String        @id @default(cuid())
  fullName     String
  phoneNumber  String        // e.g. "+212661234567"
  email        String?
  notes        String?
  appointments Appointment[]
  createdAt    DateTime      @default(now())
}

model Appointment {
  id            String         @id @default(cuid())
  startTime     DateTime
  endTime       DateTime
  status        String         @default("PENDING") // "PENDING" | "CONFIRMED" | "COMPLETED" | "CANCELLED" | "NO_SHOW"
  notes         String?
  cancellationReason String?
  
  clinicId      String
  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  
  serviceId     String
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  
  patientId     String
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  whatsappLogs  WhatsAppLog[]
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([clinicId, startTime])
}

model WhatsAppLog {
  id            String      @id @default(cuid())
  messageType   String      // "CONFIRMATION" | "REMINDER_24H" | "REMINDER_2H" | "CANCELLATION"
  recipientPhone String
  content       String
  metaMessageId String?     // ID returned by WhatsApp Cloud API
  status        String      @default("SENT") // "SENT" | "DELIVERED" | "READ" | "FAILED"
  responseReceived String?  // e.g. "CONFIRMED_BY_USER", "CANCELLED_BY_USER"
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  sentAt        DateTime    @default(now())
}
